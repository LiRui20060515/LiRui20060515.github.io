<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>汉诺塔</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>🏰 汉诺塔</h1>
        <div class="controls">
            <div class="control-group">
                <label for="diskCount">圆盘数量(3-8)：</label>
                <input type="number" id="diskCount" min="3" max="8" value="5">
            </div>
            <div class="control-group">
                <p>步数：<span id="moveCount">0</span></p >
            </div>
            <button id="resetBtn">重置</button>
            <button id="autoSolveBtn">自动演示</button>
        </div>

        <div id="warning" class="warning hidden">⚠️ 不能将大圆盘放在小圆盘上！</div>

        <div class="tower-container">
            <div class="peg" id="pegA"></div>
            <div class="peg" id="pegB"></div>
            <div class="peg" id="pegC"></div>
        </div>
    </div>

    <div class="victory-modal hidden" id="victoryModal">
        <div class="modal-content">
            <h2>🎉 闯关成功！</h2>
            <p>总步数：<span id="finalMoves">0</span></p >
            <button id="playAgainBtn">再来一局</button>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
